# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — same project as the live ɃU app (buapp.vercel.app)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Required in production. Wallet, login, and admin use this key. Must be the
# service_role secret from THAT same ɃU project (Settings → API), not a placeholder.
SUPABASE_SERVICE_ROLE_KEY=

# Airtime / Data (VTpass). Required for live phone top-ups. Without these, buy airtime/data will not charge ɃU.
# Sandbox: https://sandbox.vtpass.com/api  | Live: https://vtpass.com/api
# Public buy UI stays “Coming soon” until this is true (and you redeploy).
# NEXT_PUBLIC_VTU_ENABLED=false
# VTU_PROVIDER=vtpass
# VTU_API_URL=https://sandbox.vtpass.com/api
# VTU_API_KEY=
# VTU_PUBLIC_KEY=
# VTU_SECRET_KEY=

# Settlement / checkout keys — use LIVE keys (sk_live_ / pk_live_) on Vercel Production.
# sk_test_ / pk_test_ are test-mode only and will not take real money.
# Local .env.local does not update buapp.vercel.app; set the same live keys
# in Vercel → Project → Settings → Environment Variables, then redeploy.
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
# Dedicated Virtual Accounts (bank transfer → ɃU). Optional bank override.
# Live: wema-bank or titan-paystack. Test keys default to test-bank.
PAYSTACK_DVA_PREFERRED_BANK=

# Squad — wallet bank-in (virtual accounts). Cards stay on Paystack.
# Bank sends fall back to Squad when Paystack pauses transfers — keep the Squad wallet funded.
# Live keys from Squad Dashboard → Merchant Settings → API & Webhooks.
SQUAD_SECRET_KEY=
NEXT_PUBLIC_SQUAD_PUBLIC_KEY=
# Your 10-digit GTBank settlement account (beneficiary for customer VAs). Required for bank-in.
SQUAD_BENEFICIARY_ACCOUNT=
# Optional override. Default live: https://api-d.squadco.com  sandbox keys → sandbox-api-d.squadco.com
# SQUAD_API_BASE=

# Email via Resend (https://resend.com). Used for ticket delivery and Forgot PIN codes.
# Until you verify a domain, Resend only delivers to the email on that Resend account.
# After DNS verify, set RESEND_FROM to ɃU <tickets@yourdomain.com>
RESEND_API_KEY=
RESEND_FROM=ɃU <beth.t@example.com>

# Optional: richer in-app Support chat replies (otherwise FAQ assist still answers common questions).
# OPENAI_API_KEY=
# OPENAI_SUPPORT_MODEL=gpt-4o-mini

# AES-256 key (32+ chars) used to encrypt merchant bank account numbers
BANK_ENCRYPTION_KEY=

# Required in production. /api/cron/* rejects calls that do not send Authorization: Bearer <this>.
CRON_SECRET=

# After creating the Supabase project, run in the SQL editor (in order):
#   supabase/migrations/0001_ticketing.sql
#   supabase/migrations/0002_web_platform.sql
#   supabase/migrations/0003_compat_state.sql
#   supabase/migrations/0004_pin.sql
#   supabase/migrations/0005_auth_email_rpc.sql
#   supabase/migrations/0006_legacy_pin_login.sql
#   supabase/migrations/0007_bu_login_row.sql
#   supabase/migrations/0008_bu_live_events.sql
#   supabase/migrations/0009_event_covers.sql
#   supabase/migrations/0010_bu_live_tickets.sql
#   supabase/migrations/0011_bu_checkin_feedback.sql
#   supabase/migrations/0012_event_ticket_types.sql
#   supabase/migrations/0013_bu_update_event.sql
#   supabase/migrations/0014_event_details.sql
#   supabase/migrations/0015_account_roles_sales.sql
#   supabase/migrations/0016_super_admin_control.sql
#   supabase/migrations/0023_withdrawal_payout.sql
#   supabase/migrations/0024_gateway_live.sql
#   supabase/migrations/0029_virtual_accounts.sql
#   supabase/migrations/0039_lock_privileged_rpcs.sql
#   supabase/migrations/0040_service_role_guard.sql
# 0039 is required on the live database. It keeps wallet and login working
# through SUPABASE_SERVICE_ROLE_KEY and blocks the public anon key.
# 0003 is required if an older events table still has a `state` column instead of `status`.
# Super Admin is the platform owner only — your existing ɃU ID, not a new login.
# Organisers and affiliates never get this by registering. Comma-separated phones
# and/or live user UUIDs. Leave empty to keep /admin closed.
BU_SUPER_ADMIN_PHONES=
BU_SUPER_ADMIN_USER_IDS=

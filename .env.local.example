# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — same project as the live ɃU app (buapp.vercel.app)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional. Only needed for admin writes that RLS blocks. Must be the service_role JWT
# from THAT same ɃU project (Settings → API), not a placeholder.
SUPABASE_SERVICE_ROLE_KEY=

# Paystack — use LIVE keys (sk_live_ / pk_live_) on Vercel Production.
# sk_test_ / pk_test_ open Paystack TEST MODE and will not take real money.
# Local .env.local does not update buapp.vercel.app; set the same live keys
# in Vercel → Project → Settings → Environment Variables, then redeploy.
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Optional: ticket email via Resend
RESEND_API_KEY=
RESEND_FROM=Bison Note <tickets@bu.app>

# AES-256 key (32+ chars) used to encrypt merchant bank account numbers
BANK_ENCRYPTION_KEY=

# Cron secret for /api/cron/* (expire reservations + webhook retries)
CRON_SECRET=

# After creating the Supabase project, run in the SQL editor (in order):
#   supabase/migrations/0001_ticketing.sql
#   supabase/migrations/0002_web_platform.sql
#   supabase/migrations/0003_compat_state.sql
#   supabase/migrations/0004_pin.sql
#   supabase/migrations/0005_auth_email_rpc.sql
#   supabase/migrations/0006_legacy_pin_login.sql
#   supabase/migrations/0007_bu_login_row.sql
#   supabase/migrations/0008_bu_live_events.sql
#   supabase/migrations/0009_event_covers.sql
#   supabase/migrations/0010_bu_live_tickets.sql
#   supabase/migrations/0011_bu_checkin_feedback.sql
#   supabase/migrations/0012_event_ticket_types.sql
#   supabase/migrations/0013_bu_update_event.sql
#   supabase/migrations/0014_event_details.sql
#   supabase/migrations/0015_account_roles_sales.sql
#   supabase/migrations/0016_super_admin_control.sql
#   supabase/migrations/0023_withdrawal_payout.sql
# 0003 is required if an older events table still has a `state` column instead of `status`.
# Super Admin is the platform owner only — your existing ɃU ID, not a new login.
# Organisers and affiliates never get this by registering. Comma-separated phones
# and/or live user UUIDs. Leave empty to keep /admin closed.
BU_SUPER_ADMIN_PHONES=
BU_SUPER_ADMIN_USER_IDS=

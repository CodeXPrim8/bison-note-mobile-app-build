# App
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Paystack (required for live charges; demo checkout is used when unset)
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Optional: ticket email via Resend
RESEND_API_KEY=
RESEND_FROM=Bison Note <tickets@bu.app>

# AES-256 key (32+ chars) used to encrypt merchant bank account numbers
BANK_ENCRYPTION_KEY=

# Cron secret for /api/cron/* (expire reservations + webhook retries)
CRON_SECRET=

# Optional WhatsApp delivery (Twilio). Leave disabled unless configured.
WHATSAPP_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
